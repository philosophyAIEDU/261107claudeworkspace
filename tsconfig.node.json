{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
